generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model DaDemoLead {
  lead_id            Int      @id @default(autoincrement())
  full_name          String
  email              String
  phone              String
  candidate_type     String?
  current_job_role   String?
  experience_range   String?
  qualification      String?
  year_of_passout    String?
  career_goal        String?
  preferred_batch    String?
  city               String?
  lead_source        String?
  lead_sub_source    String?
  page_url           String?
  course_interested  String?
  ip_address         String?
  lead_status        String   @default("New")
  created_at         DateTime @default(now())

  @@map("da_demo_leads")
}

model DaContactMessage {
  message_id     Int      @id @default(autoincrement())
  full_name      String
  email          String
  phone          String?
  inquiry_type   String?
  message        String
  consent_given  Boolean  @default(false)
  status         String   @default("New")
  created_at     DateTime @default(now())

  @@map("da_contact_messages")
}

model DaEmailSubscription {
  subscription_id   Int       @id @default(autoincrement())
  email             String    @unique
  status            String    @default("Subscribed")
  subscribed_at     DateTime  @default(now())
  unsubscribed_at   DateTime?

  @@map("da_email_subscriptions")
}

model DaTestimonials {
  testimonial_id     Int      @id @default(autoincrement())
  batch              String?
  full_name          String
  email              String
  phone_number       String
  current_job_role   String?
  current_company    String?
  company_location   String?
  career_goal        String?
  linkedin_profile   String?
  testimonial        String
  photo_url          String?
  video_testimonial  Boolean   @default(false)
  consent            Boolean   @default(false)
  submitted_at       DateTime  @default(now())

  @@map("da_testimonials")
}

model StudentGoogleLead {
  lead_id           Int      @id @default(autoincrement())
  full_name         String
  email_id          String
  whatsapp_number   String
  year_of_passout   String
  qualification     String

  lead_status       String?   @default("New Lead")
  lead_source       String?
  lead_sub_source   String?  

  utm_source        String?
  utm_medium        String?
  utm_campaign      String?
  utm_term          String?
  utm_content       String?
  gclid             String?

  landing_page      String?
  page_url          String?
  form_type         String?

  created_at        DateTime @default(now())
  lead_stage        String   @default("New Lead")

  @@map("student_google_leads")
}

model ProfessionalsGoogleLead {
  lead_id            Int      @id @default(autoincrement())
  full_name          String
  email_id           String
  whatsapp_number    String
  year_of_experience String
  current_role       String

  lead_status       String?   @default("New Lead")
  lead_source       String?
  lead_sub_source   String?

  utm_source         String?
  utm_medium         String?
  utm_campaign       String?
  utm_term           String?
  utm_content        String?
  gclid              String?

  landing_page       String?
  page_url           String?
  form_type          String?

  created_at         DateTime @default(now())
  lead_stage         String   @default("New Lead")

  @@map("professionals_google_leads")
}

model EmailSubscription {
  sno       Int      @id @default(autoincrement())
  email     String
  section   String
  createdAt DateTime @default(now()) @map("createdat")

  @@map("email_subscription")
}
